{
  "name": "cobrowse-agent-ui",
  "version": "1.7.0-rc.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobrowseio/cobrowse-agent-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/cobrowse-agent-ui.js",
  "module": "./dist/cobrowse-agent-ui.js",
  "types": "./dist/cobrowse-agent-ui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cobrowse-agent-ui.d.ts",
      "import": "./dist/cobrowse-agent-ui.js"
    },
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "import": "./dist/integrations.js"
    },
    "./style.css": "./dist/cobrowse-agent-ui.css"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "vp config && vp run build",
    "i18n": "i18next-cli extract",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "vp lint . && i18next-cli lint --quiet"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^24.2.2",
    "react-i18next": "^15.4.0",
    "ua-parser-js": "^1.0.33"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^5.1.1",
    "cobrowse-agent-sdk": "^3.0.0-rc.6",
    "i18next-cli": "^1.42.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0",
    "vite-plus": "1.0.0-rc.0"
  },
  "peerDependencies": {
    "cobrowse-agent-sdk": "^3.0.0-rc.6",
    "react": "^19.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "download"
    }
  }
}
